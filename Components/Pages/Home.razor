@page "/"


<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Support Angula's mission to transform Nigeria’s education with a new laptop. Donate to empower students and educators!">
    <meta name="keywords" content="Angula, Nigeria, education, technology, fundraising, donation">
    <meta name="author" content="Angula">
    <meta property="og:title" content="Help Angula Transform Nigeria’s Education">
    <meta property="og:description" content="Donate to help Angula get a laptop to build a school management system for Nigerian schools.">
    <meta property="og:image" content="images/Dark Brown Modern Elegant Gadget Laptop Store Sale Facebook Post.png">
    <meta property="og:url" content="https://paystack.shop/pay/angula">
    <meta name="twitter:card" content="summary_large_image">
    <title>Angula's Fundraiser for Nigeria’s Digital Education</title>

    <!-- Google Fonts (Poppins) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS and Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="assets/css/site.css" rel="stylesheet">
    <!-- Custom JS -->
    <script src="/assets/js/site.js" defer></script>
</head>
<body>
    <div class="container my-5">
        <!-- Theme Toggle Button -->
        <div class="theme-toggle position-fixed top-0 end-0 m-3 m-md-4">
            <button id="themeToggle" class="btn btn-outline-secondary rounded-circle p-2" title="Toggle Theme" aria-label="Toggle between light and dark theme">
                <i class="bi bi-sun-fill"></i>
                <i class="bi bi-moon-stars-fill d-none"></i>
            </button>
        </div>

        <!-- Mission Statement -->
        <header class="text-center mb-5">
            <h1 class="mission-statement h2 fw-bold">Empowering Nigeria’s Digital Future Through Education</h1>
            <p class="mission-subtext text-muted">Your support helps Angula continue building innovative solutions for Nigeria’s schools and digital communities!</p>
        </header>

        <!-- Main Content -->
        <main class="row justify-content-center g-4">
            <!-- Fundraising Card -->
            <section class="col-lg-7 col-md-12">
                <article class="card shadow-sm fundraiser-card">
                    <img src="images/Dark Brown Modern Elegant Gadget Laptop Store Sale Facebook Post.png" class="card-img-top" alt="Angula's Fundraising Campaign" loading="lazy">
                    <div class="card-body text-center p-4">
                        <h2 class="card-title">Help Angula Get a Laptop to Transform Nigeria’s Education</h2>
                        <p class="card-text">
                            I’m Angula, a passionate coder dedicated to uplifting Nigeria’s educational and digital sectors. My laptop broke, halting my work on a school management system that will streamline operations for Nigerian schools. I’m raising ₦500,000 (≈ $300 USD) for a new laptop to complete my online course, finish this project, and mentor others in Nigeria’s growing digital space. Your donation will empower students, educators, and communities—join me in making a lasting impact!
                        </p>
                        <h3 class="h4 fw-semibold">Goal: ₦500,000</h3>
                        <div class="progress mb-4" role="progressbar" aria-label="Fundraising progress" id="progressBar">
                            <div class="progress-bar bg-success" style="width: 0%;" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">
                                <span id="raisedAmount">₦0</span>
                            </div>
                        </div>
                        <a href="https://paystack.shop/pay/angula" class="btn btn-primary btn-lg mb-4 donate-btn" target="_blank" rel="noopener noreferrer">Donate Now & Change Lives</a>
                        <p class="fw-semibold">Share to support Nigeria’s digital education revolution:</p>
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <a href="https://twitter.com/intent/tweet?text=Support%20Angula%20to%20empower%20Nigerian%20schools%20with%20tech!%20Donate:%20https://paystack.shop/pay/m3j4n4u2lb%20%23TechForNigeria%20%23Education" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">
                                <i class="bi bi-twitter"></i> Share on X
                            </a>
                            <a href="https://www.facebook.com/sharer/sharer.php?u=https://paystack.shop/pay/m3j4n4u2lb" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">
                                <i class="bi bi-facebook"></i> Share on Facebook
                            </a>
                            <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">
                                <i class="bi bi-instagram"></i> Share on Instagram
                            </a>
                        </div>
                    </div>
                </article>
            </section>

            <!-- Gallery and Projects -->
            <aside class="col-lg-5 col-md-12">
                <!-- Gallery Carousel -->
                <section class="card shadow-sm gallery-card mb-4">
                    <div id="galleryCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="images/image1.png" class="d-block w-100" alt="Angula coding" loading="lazy">
                                <div class="carousel-caption d-none d-md-block">
                                    <p>Angula crafting digital solutions</p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="images/image2.png" class="d-block w-100" alt="Nigerian school" loading="lazy">
                                <div class="carousel-caption d-none d-md-block">
                                    <p>Modernizing Nigerian schools</p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="images/image3.png" class="d-block w-100" alt="New laptop goal" loading="lazy">
                                <div class="carousel-caption d-none d-md-block">
                                    <p>The laptop to fuel Angula’s mission</p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="images/image4.jpg" class="d-block w-100" alt="Community coding session" loading="lazy">
                                <div class="carousel-caption d-none d-md-block">
                                    <p>Inspiring Nigeria’s next coders</p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="images/image5.jpg" class="d-block w-100" alt="Nigerian students" loading="lazy">
                                <div class="carousel-caption d-none d-md-block">
                                    <p>Students empowered by technology</p>
                                </div>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#galleryCarousel" data-bs-slide="prev" aria-label="Previous slide">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#galleryCarousel" data-bs-slide="next" aria-label="Next slide">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </section>

                <!-- Previous Projects -->
                <section class="projects-section">
                    <h2 class="text-center mb-4 fw-bold">Angula’s Contributions to Nigeria’s Digital Space</h2>
                    <div class="row g-3">
                        <article class="col-12">
                            <div class="card shadow-sm project-card h-100">
                                <div class="card-body p-3">
                                    <h3 class="card-title h5">Trading Bot with Accurate Forex Chart Forecast</h3>
                                    <p class="card-text">Built a trading bot with advanced algorithms, empowering Nigerian traders with precise, data-driven tools for financial success.</p>
                                </div>
                            </div>
                        </article>
                        <article class="col-12">
                            <div class="card shadow-sm project-card h-100">
                                <div class="card-body p-3">
                                    <h3 class="card-title h5">Hotel Management System</h3>
                                    <p class="card-text">Developed a digital solution to streamline hotel operations, boosting efficiency in Nigeria’s hospitality industry.</p>
                                </div>
                            </div>
                        </article>
                        <article class="col-12">
                            <div class="card shadow-sm project-card h-100">
                                <div class="card-body p-3">
                                    <h3 class="card-title h5">Visitors Management System</h3>
                                    <p class="card-text">Created a secure platform to manage visitors, enhancing safety and organization for Nigerian institutions.</p>
                                </div>
                            </div>
                        </article>
                        <article class="col-12">
                            <div class="card shadow-sm project-card h-100">
                                <div class="card-body p-3">
                                    <h3 class="card-title h5">School Management System (Current)</h3>
                                    <p class="card-text">Building a transformative platform to digitize Nigerian schools, empowering educators and students with modern tools.</p>
                                </div>
                            </div>
                        </article>
                    </div>
                </section>
            </aside>
        </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

</body>
</html>