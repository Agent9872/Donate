@page "/finance-report"
@rendermode InteractiveServer

<PageTitle>Finance Deep Dive Analysis Report</PageTitle>

<link href="~/finance-report.css" rel="stylesheet" />

<div class="presentation-container">
    <!-- Slide 1: Title Slide -->
    <div class="slide title-slide">
        <div class="slide-content text-center">
            <h1 class="presentation-title">RePORT on FINANCE DEEPDIVE ANALYSIS and OUTCOMES</h1>
            <h2 class="presentation-subtitle">JULY 2025</h2>
            <div class="image-placeholder">
                [Placeholder for image1.png]
            </div>
        </div>
    </div>

    <!-- Slide 2: Background and Objectives -->
    <div class="slide content-slide">
        <div class="slide-content">
            <h2 class="slide-title">Background and Objectives</h2>
            <div class="slide-body">
                <h3>Background</h3>
                <ul>
                    <li>Finance Deep Dive Analysis conducted with Finance team and Head of Operations (June–July 2025).</li>
                </ul>
                
                <h3>Objectives</h3>
                <ol>
                    <li>Investigate root causes of stress, burnout, and challenges in meeting key tasks.</li>
                    <li>Leverage the GAIN Procurement System (GPS) and Payment Voucher Integration for GAIN Nigeria Finance team.</li>
                    <li>Improve and streamline current work systems, processes, and procedures.</li>
                </ol>
                
                <div class="image-placeholder">
                    [Placeholder for image2.png]
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 3: Key Findings -->
    <div class="slide content-slide">
        <div class="slide-content">
            <h2 class="slide-title">Key Findings</h2>
            <div class="slide-body">
                <h3>Key Findings</h3>
                <ul>
                    <li>Major finance team tasks (e.g., payment processing) are monotonous, cumbersome, and manual.</li>
                    <li>Challenges addressed by leveraging:
                        <ul>
                            <li>Newly deployed GAIN Procurement System (GPS).</li>
                            <li>Existing Travel site with activated Finance team access.</li>
                            <li>Payment Voucher system on Navision.</li>
                        </ul>
                    </li>
                </ul>
                
                <div class="image-placeholder">
                    [Placeholder for image3.png]
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 4: Current vs. Proposed Payment Processes (Table) -->
    <div class="slide content-slide">
        <div class="slide-content">
            <h2 class="slide-title">Current vs. Proposed Payment Processes</h2>
            <div class="slide-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped process-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Process</th>
                                <th>Current Process</th>
                                <th>Proposed Process</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Vendor Payments</strong></td>
                                <td>Completed on GPS.</td>
                                <td>All vendor payments (including participants) processed on GPS.</td>
                            </tr>
                            <tr>
                                <td><strong>Travel Claims</strong></td>
                                <td>Requesters upload claims with expense reports on SharePoint.</td>
                                <td>Processed on Travel site with line manager's approval uploaded.</td>
                            </tr>
                            <tr>
                                <td><strong>Payment Vouchers & Documents</strong></td>
                                <td>Manual vouchers; signed checklists; separate SharePoint folder for documents.</td>
                                <td>Automatic vouchers on Navision; no checklists; documents saved on global SharePoint.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <div class="image-placeholder">
                    [Placeholder for image4.png]
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 5: Proposed Payment Action Process -->
    <div class="slide content-slide">
        <div class="slide-content">
            <h2 class="slide-title">Proposed Payment Action Process</h2>
            <div class="slide-body">
                <h3>Weekly Payment Process Flow</h3>
                <div class="process-flow">
                    <div class="process-step">
                        <h4>1. Tuesday (Finance Assistant)</h4>
                        <ul>
                            <li>Review payments on GPS and Travel site.</li>
                            <li>Mark as 'Paid' or 'Reject' with reason.</li>
                            <li>Download CSV for completed payments and upload to Navision.</li>
                        </ul>
                    </div>
                    
                    <div class="process-step">
                        <h4>2. Wednesday (Finance Officer)</h4>
                        <ul>
                            <li>Review and submit payments for Finance Manager's review on Navision.</li>
                            <li>Conduct compliance checks (SCUML & NIGSA for vendors).</li>
                        </ul>
                    </div>
                    
                    <div class="process-step">
                        <h4>3. Thursday (Finance Manager & Head of Operations)</h4>
                        <ul>
                            <li>Review and approve payments on Navision PO.</li>
                        </ul>
                    </div>
                    
                    <div class="process-step">
                        <h4>4. Thursday (Finance Officer)</h4>
                        <ul>
                            <li>Post and print payments on Navision; compile payment package for final approval.</li>
                        </ul>
                    </div>
                    
                    <div class="process-step">
                        <h4>5. Thursday (FM, HoOps, CMT)</h4>
                        <ul>
                            <li>Final approval of payment package.</li>
                        </ul>
                    </div>
                    
                    <div class="process-step">
                        <h4>6. Next Monday (Finance Manager)</h4>
                        <ul>
                            <li>Provide payment advice to staff or notify requesters of unprocessed payments.</li>
                            <li><em>Note: Payment week cutoff is Monday.</em></li>
                        </ul>
                    </div>
                </div>
                
                <div class="image-placeholder">
                    [Placeholder for image18.emf]
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 6: Proposed Payment Process Flowchart -->
    <div class="slide content-slide">
        <div class="slide-content">
            <h2 class="slide-title">Proposed Payment Process Flowchart</h2>
            <div class="slide-body">
                <h3>Flowchart Overview</h3>
                <ul>
                    <li><strong>Requester:</strong> Submits payments via GPS or Travel site.</li>
                    <li><strong>Finance Assistant:</strong> Reviews documents; downloads CSV for Navision.</li>
                    <li><strong>Finance Officer:</strong> Conducts compliance checks; submits for approval.</li>
                    <li><strong>Finance Manager/HoOps/CMT:</strong> Approves payments on Navision PO.</li>
                    <li><strong>Finance Officer:</strong> Posts and prints payments; compiles package.</li>
                    <li><strong>Finance Manager:</strong> Notifies staff of payment status.</li>
                    <li><strong>Re-initiation:</strong> Failed payments are re-initiated or notified.</li>
                </ul>
                
                <div class="image-placeholder">
                    [Placeholder for image19.emf]
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 7: Contact Information -->
    <div class="slide content-slide">
        <div class="slide-content">
            <h2 class="slide-title">Contact Information</h2>
            <div class="slide-body">
                <div class="contact-info">
                    <h3>Global Alliance for Improved Nutrition (GAIN)</h3>
                    <ul class="contact-details">
                        <li><strong>Address:</strong> Rue Varembé 7, 1202 Geneva, Switzerland</li>
                        <li><strong>Mailing Address:</strong> PO Box 55, 1211 Genève 20</li>
                        <li><strong>Website:</strong> <a href="https://www.gainhealth.org" target="_blank">www.gainhealth.org</a></li>
                        <li><strong>Email:</strong> <a href="mailto:info@gainhealth.org">info@gainhealth.org</a></li>
                        <li><strong>Social Media:</strong> @@GAINAlliance</li>
                    </ul>
                </div>
                
                <div class="image-placeholder">
                    [Placeholder for image20.png]
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 8: Thank You -->
    <div class="slide thank-you-slide">
        <div class="slide-content text-center">
            <h1 class="thank-you-title">Thank You</h1>
            <p class="thank-you-message">For your attention and support in implementing these process improvements.</p>
            
            <div class="image-placeholder">
                [Placeholder for image21.png]
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <div class="slide-navigation">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <button class="btn btn-secondary me-2" onclick="previousSlide()">← Previous</button>
                    <span class="slide-counter">Slide <span id="currentSlide">1</span> of 8</span>
                    <button class="btn btn-secondary ms-2" onclick="nextSlide()">Next →</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentSlideIndex = 0;
    const slides = document.querySelectorAll('.slide');
    const totalSlides = slides.length;

    function showSlide(index) {
        slides.forEach((slide, i) => {
            slide.style.display = i === index ? 'block' : 'none';
        });
        document.getElementById('currentSlide').textContent = index + 1;
    }

    function nextSlide() {
        currentSlideIndex = (currentSlideIndex + 1) % totalSlides;
        showSlide(currentSlideIndex);
    }

    function previousSlide() {
        currentSlideIndex = (currentSlideIndex - 1 + totalSlides) % totalSlides;
        showSlide(currentSlideIndex);
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
        showSlide(0);
        
        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowRight' || e.key === ' ') {
                nextSlide();
            } else if (e.key === 'ArrowLeft') {
                previousSlide();
            }
        });
    });
</script>
